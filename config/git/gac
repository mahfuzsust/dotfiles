#!/usr/bin/env bash
set -euo pipefail

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "gac: not a git repository" >&2
  exit 1
fi

git add -A

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
  echo "gac: unable to determine current branch (detached HEAD?)" >&2
  exit 1
fi

types=(amend feat fix refactor docs style test chore perf ci build revert)

pick_option() {
  local prompt="$1"
  shift
  local choice=""

  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    choice="$(printf '%s\n' "$@" | fzf --prompt="${prompt} " --height=40% --border --reverse)"
  else
    echo "Select ${prompt}:"
    PS3="${prompt}> "
    select choice in "$@"; do
      if [[ -n "${choice:-}" ]]; then
        break
      fi
      echo "Invalid selection, try again."
    done
  fi

  printf '%s' "$choice"
}

action="$(pick_option "Commit type" "${types[@]}")"

if [[ -z "${action:-}" ]]; then
  echo "gac: aborted" >&2
  exit 1
fi

amend=0
type="$action"
default_message=""

if [[ "$action" == amend ]]; then
  amend=1
  if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "gac: nothing to amend (no commits yet)" >&2
    exit 1
  fi

  prev_subject="$(git log -1 --pretty=%s)"
  if [[ "$prev_subject" == *"("*"): "* ]]; then
    type="${prev_subject%%(*}"
    default_message="${prev_subject#*: }"
  else
    type="chore"
    default_message="$prev_subject"
  fi
fi

if [[ -n "$default_message" ]]; then
  read -r -p "Commit message [${default_message}]: " message
  message="${message:-$default_message}"
else
  read -r -p "Commit message: " message
fi

message="${message%"${message##*[![:space:]]}"}"
message="${message%.}"

if [[ -z "$message" ]]; then
  echo "gac: empty commit message, aborted" >&2
  exit 1
fi

commit_msg="${type}(${branch}): ${message}"

if (( amend )); then
  git commit --amend -m "$commit_msg"
else
  git commit -m "$commit_msg"
fi

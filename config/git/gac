#!/usr/bin/env bash
set -euo pipefail

_gac_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_interactive="${XDG_CONFIG_HOME:-$HOME/.config}/shell/interactive-helpers.sh"
[[ -f "$_interactive" ]] || _interactive="${_gac_dir}/../shell/interactive-helpers.sh"
if [[ ! -f "$_interactive" ]]; then
  echo "gac: interactive helpers not found; run dotinstall" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$_interactive"

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "gac: not a git repository" >&2
  exit 1
fi

git add -A

branch="$(git branch --show-current)"
if [[ -z "$branch" ]]; then
  echo "gac: unable to determine current branch (detached HEAD?)" >&2
  exit 1
fi

types=(amend feat fix refactor docs style test chore perf ci build revert)

action="$(pick_option "Commit type" "${types[@]}" || true)"

if [[ -z "${action:-}" ]]; then
  echo "gac: aborted" >&2
  exit 1
fi

amend=0
type="$action"
default_message=""

if [[ "$action" == amend ]]; then
  amend=1
  if ! git rev-parse --verify HEAD >/dev/null 2>&1; then
    echo "gac: nothing to amend (no commits yet)" >&2
    exit 1
  fi

  prev_subject="$(git log -1 --pretty=%s)"
  if [[ "$prev_subject" == *"("*"): "* ]]; then
    type="${prev_subject%%(*}"
    default_message="${prev_subject#*: }"
  else
    type="chore"
    default_message="$prev_subject"
  fi
fi

message="$(prompt_input "Commit message" "$default_message" || true)"

message="${message%"${message##*[![:space:]]}"}"
message="${message%.}"

if [[ -z "$message" ]]; then
  echo "gac: empty commit message, aborted" >&2
  exit 1
fi

commit_msg="${type}(${branch}): ${message}"

if (( amend )); then
  git commit --amend -m "$commit_msg"
else
  git commit -m "$commit_msg"
fi

#!/usr/bin/env bash
set -euo pipefail

_GPR_BODY_FILE=""

usage() {
  echo "usage: gpr [--default-base]" >&2
  echo "  --default-base  target main/master (or repo default); used by gprm" >&2
}

require_gh() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "gpr: gh CLI not found. Install with: brew install gh" >&2
    exit 1
  fi
  if ! gh auth status >/dev/null 2>&1; then
    echo "gpr: gh not authenticated. Run: gh auth login" >&2
    exit 1
  fi
}

require_git_repo() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "gpr: not a git repository" >&2
    exit 1
  fi
}

current_branch() {
  local branch
  branch="$(git branch --show-current)"
  if [[ -z "$branch" ]]; then
    echo "gpr: unable to determine current branch (detached HEAD?)" >&2
    exit 1
  fi
  printf '%s' "$branch"
}

detect_default_base() {
  local base=""

  base="$(gh repo view --json defaultBranchRef -q .defaultBranchRef.name 2>/dev/null || true)"
  if [[ -n "$base" ]]; then
    printf '%s' "$base"
    return 0
  fi

  if git symbolic-ref -q refs/remotes/origin/HEAD >/dev/null 2>&1; then
    base="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
    if [[ -n "$base" ]]; then
      printf '%s' "$base"
      return 0
    fi
  fi

  local candidate
  for candidate in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$candidate" 2>/dev/null; then
      printf '%s' "$candidate"
      return 0
    fi
  done

  echo "gpr: could not detect default base branch (main/master)" >&2
  exit 1
}

select_base_branch() {
  local branches branch selected=""

  branches=()
  while IFS= read -r branch; do
    [[ -n "$branch" ]] && branches+=("$branch")
  done < <(
    git branch -r \
      | sed 's/^[[:space:]]*origin\///' \
      | grep -vE '^HEAD' \
      | sort -u
  )

  if [[ ${#branches[@]} -eq 0 ]]; then
    echo "gpr: no remote branches found" >&2
    exit 1
  fi

  if command -v fzf >/dev/null 2>&1; then
    selected="$(
      printf '%s\n' "${branches[@]}" \
        | fzf --prompt='PR base branch> ' --height=40% --border --reverse
    )"
  else
    echo "Select base branch:" >&2
    PS3="PR base branch> "
    select branch in "${branches[@]}"; do
      if [[ -n "${branch:-}" ]]; then
        selected="$branch"
        break
      fi
      echo "Invalid selection, try again." >&2
    done
  fi

  if [[ -z "$selected" ]]; then
    echo "gpr: aborted" >&2
    exit 1
  fi

  _GPR_RESULT="$selected"
}

commits_ahead_of_base() {
  local target_base="$1"
  local merge_base count=0

  if git show-ref --verify --quiet "refs/remotes/origin/$target_base" 2>/dev/null; then
    merge_base="$(git merge-base "origin/$target_base" HEAD 2>/dev/null || true)"
  else
    merge_base="$(git merge-base "$target_base" HEAD 2>/dev/null || true)"
  fi

  if [[ -n "$merge_base" ]]; then
    count="$(git rev-list --count "$merge_base"..HEAD 2>/dev/null || echo 0)"
  elif git show-ref --verify --quiet "refs/remotes/origin/$target_base" 2>/dev/null; then
    count="$(git rev-list --count "origin/$target_base"..HEAD 2>/dev/null || echo 0)"
  else
    count="$(git rev-list --count "$target_base"..HEAD 2>/dev/null || echo 0)"
  fi

  printf '%s' "$count"
}

ensure_commits_ahead_of_base() {
  local target_base="$1"
  local count head_branch

  head_branch="$(current_branch)"

  if [[ "$head_branch" == "$target_base" ]]; then
    echo "gpr: you are on the base branch ($target_base)" >&2
    echo "gpr: checkout a feature branch and create a commit first." >&2
    exit 1
  fi

  count="$(commits_ahead_of_base "$target_base")"
  if [[ "$count" -eq 0 ]]; then
    echo "gpr: no commits between $target_base and $head_branch" >&2
    echo "gpr: create a commit first, then try again." >&2
    exit 1
  fi
}

default_title_for_branch() {
  local target_base="$1"
  local count

  count="$(commits_ahead_of_base "$target_base")"
  if [[ "$count" -eq 1 ]]; then
    git log -1 --pretty=%s HEAD
  fi
}

prompt_title() {
  local default_title="${1:-}"
  local input=""
  local result=""

  if [[ -n "$default_title" ]]; then
    read -r -p "PR title [$default_title]: " input
    result="${input:-$default_title}"
  else
    result=""
    while [[ -z "$result" ]]; do
      read -r -p "PR title: " input
      result="${input%"${input##*[![:space:]]}"}"
      if [[ -z "$result" ]]; then
        echo "Title cannot be empty." >&2
      fi
    done
  fi

  result="${result%"${result##*[![:space:]]}"}"
  _GPR_RESULT="$result"
}

edit_description() {
  local template_file editor
  template_file="$(mktemp "${TMPDIR:-/tmp}/gpr-body.XXXXXX")"

  cat >"$template_file" <<'EOF'
### Implementation



### Why


EOF

  editor="${GIT_PR_EDITOR:-${EDITOR:-nvim}}"
  if ! "$editor" "$template_file" </dev/tty >/dev/tty 2>&1; then
    echo "gpr: editor exited with an error" >&2
    rm -f "$template_file"
    exit 1
  fi

  _GPR_RESULT="$template_file"
}

prompt_pr_state() {
  local choice=""

  if command -v fzf >/dev/null 2>&1; then
    choice="$(printf 'ready\ndraft' | fzf --prompt='PR state> ' --height=10 --border --reverse)"
  else
    echo "Select PR state:" >&2
    PS3="PR state> "
    select choice in ready draft; do
      [[ -n "${choice:-}" ]] && break
      echo "Invalid selection, try again." >&2
    done
  fi

  if [[ -z "${choice:-}" ]]; then
    echo "gpr: aborted" >&2
    exit 1
  fi

  _GPR_RESULT="$choice"
}

ensure_branch_pushed() {
  local branch
  branch="$(current_branch)"

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    local ahead=0
    ahead="$(git rev-list --count @{u}..HEAD 2>/dev/null || echo 0)"
    if [[ "$ahead" -gt 0 ]]; then
      git push
    fi
  else
    git push -u origin "$branch"
  fi
}

show_pr_url() {
  local url="$1"

  if command -v pbcopy >/dev/null 2>&1; then
    printf '%s' "$url" | pbcopy
    echo "PR URL copied to clipboard."
  fi

  printf '\n\033[1;32mPull request created\033[0m\n'
  printf '\033]8;;%s\033\\' "$url"
  printf '\033[36m\033[4m%s\033[0m' "$url"
  printf '\033]8;;\033\\\n'
}

cleanup_body_file() {
  [[ -n "$_GPR_BODY_FILE" ]] && rm -f "$_GPR_BODY_FILE"
}

main() {
  local use_default_base=0
  local base="" default_title="" pr_url=""
  local title="" body_file="" pr_state=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --default-base)
        use_default_base=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        echo "gpr: unknown option: $1" >&2
        usage
        exit 1
        ;;
    esac
  done

  require_gh
  require_git_repo

  if (( use_default_base )); then
    base="$(detect_default_base)"
    echo "Base branch: $base"
  else
    select_base_branch
    base="$_GPR_RESULT"
  fi

  ensure_commits_ahead_of_base "$base"

  default_title="$(default_title_for_branch "$base")"
  prompt_title "$default_title"
  title="$_GPR_RESULT"
  edit_description
  body_file="$_GPR_RESULT"
  _GPR_BODY_FILE="$body_file"
  trap cleanup_body_file EXIT
  prompt_pr_state
  pr_state="$_GPR_RESULT"

  ensure_branch_pushed

  if [[ "$pr_state" == "draft" ]]; then
    pr_url="$(
      gh pr create \
        --base "$base" \
        --title "$title" \
        --body-file "$body_file" \
        --assignee "@me" \
        --draft
    )"
  else
    pr_url="$(
      gh pr create \
        --base "$base" \
        --title "$title" \
        --body-file "$body_file" \
        --assignee "@me"
    )"
  fi

  show_pr_url "$pr_url"
}

main "$@"

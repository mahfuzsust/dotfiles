#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: gclean [-f]" >&2
  echo "  Delete merged local branches whose remote was deleted" >&2
  echo "  List local branches with no upstream tracking" >&2
  echo "  -f  delete all local branches with no upstream tracking" >&2
}

require_git_repo() {
  if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "gclean: not a git repository" >&2
    exit 1
  fi
}

current_branch() {
  git branch --show-current 2>/dev/null || true
}

detect_default_base() {
  local base=""

  if git symbolic-ref -q refs/remotes/origin/HEAD >/dev/null 2>&1; then
    base="$(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@')"
    [[ -n "$base" ]] && printf '%s' "$base" && return 0
  fi

  for base in main master; do
    if git show-ref --verify --quiet "refs/remotes/origin/$base" 2>/dev/null \
      || git show-ref --verify --quiet "refs/heads/$base" 2>/dev/null; then
      printf '%s' "$base"
      return 0
    fi
  done

  echo "gclean: could not detect default base branch" >&2
  exit 1
}

is_protected_branch() {
  local branch="$1"
  local current="$2"
  local default_base="$3"

  [[ "$branch" == "$current" ]] && return 0
  [[ "$branch" == "$default_base" ]] && return 0
  [[ "$branch" == "main" || "$branch" == "master" ]] && return 0
  return 1
}

branch_is_merged_into_base() {
  local branch="$1"
  local default_base="$2"

  if git show-ref --verify --quiet "refs/remotes/origin/$default_base" 2>/dev/null; then
    git merge-base --is-ancestor "$branch" "origin/$default_base"
    return
  fi

  if git show-ref --verify --quiet "refs/heads/$default_base" 2>/dev/null; then
    git merge-base --is-ancestor "$branch" "$default_base"
    return
  fi

  return 1
}

delete_gone_merged_branches() {
  local default_base="$1"
  local current="$2"
  local branch track deleted=0

  while read -r branch track; do
    [[ -z "$branch" ]] && continue
    [[ "$track" != "[gone]" ]] && continue
    is_protected_branch "$branch" "$current" "$default_base" && continue

    if branch_is_merged_into_base "$branch" "$default_base"; then
      git branch -d "$branch"
      echo "Deleted merged branch (remote gone): $branch"
      deleted=1
    else
      echo "Skipped branch (remote gone, not merged): $branch" >&2
    fi
  done < <(git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads/)

  if [[ "$deleted" -eq 0 ]]; then
    echo "No merged branches with deleted remotes to remove."
  fi
}

list_untracked_branches() {
  local default_base="$1"
  local current="$2"
  local branch upstream found=0

  echo "Branches with no upstream tracking:"

  while read -r branch upstream; do
    [[ -z "$branch" ]] && continue
    [[ -n "$upstream" ]] && continue
    is_protected_branch "$branch" "$current" "$default_base" && continue
    printf '  %s\n' "$branch"
    found=1
  done < <(git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads/)

  if [[ "$found" -eq 0 ]]; then
    echo "  (none)"
  fi
}

delete_untracked_branches() {
  local default_base="$1"
  local current="$2"
  local branch upstream deleted=0

  while read -r branch upstream; do
    [[ -z "$branch" ]] && continue
    [[ -n "$upstream" ]] && continue
    is_protected_branch "$branch" "$current" "$default_base" && continue

    git branch -D "$branch"
    echo "Deleted branch (no upstream): $branch"
    deleted=1
  done < <(git for-each-ref --format='%(refname:short) %(upstream:short)' refs/heads/)

  if [[ "$deleted" -eq 0 ]]; then
    echo "No untracked branches to delete."
  fi
}

main() {
  local force=0
  local default_base current

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -f)
        force=1
        shift
        ;;
      -h | --help)
        usage
        exit 0
        ;;
      *)
        echo "gclean: unknown option: $1" >&2
        usage
        exit 1
        ;;
    esac
  done

  require_git_repo

  echo "Fetching and pruning remotes..."
  git fetch --prune --quiet

  default_base="$(detect_default_base)"
  current="$(current_branch)"

  echo "Default base branch: $default_base"
  echo

  echo "== Merged branches with deleted remotes =="
  delete_gone_merged_branches "$default_base" "$current"
  echo

  if (( force )); then
    echo "== Deleting branches with no upstream tracking =="
    delete_untracked_branches "$default_base" "$current"
  else
    list_untracked_branches "$default_base" "$current"
    echo
    echo "Run 'gclean -f' to delete branches with no upstream tracking."
  fi
}

main "$@"

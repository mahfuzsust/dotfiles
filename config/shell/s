# Search text in a directory with ripgrep.
# Quote patterns that start with * so the shell does not expand them.
#
# Usage: s <pattern> [path]
#   s abc         search for abc (ripgrep regex; smart-case from ripgreprc)
#   s '*abc'      lines ending with abc
#   s 'abc*'      lines starting with abc
#   s '*abc*'     lines containing abc (same as abc for plain text)
#   s abc ./src   search under ./src
#
# Ctrl+F / Ctrl+N: type a full ripgrep argument list (e.g. -i -t md TODO), not s wildcards.

_search_usage() {
  cat >&2 <<'EOF'
usage: s <pattern> [path]

Wildcards (quote patterns that contain *):
  abc       ripgrep search for abc
  *abc      lines ending with abc
  abc*      lines starting with abc
  *abc*     lines containing abc

Examples:
  s timeout
  s '*Error' ./src
  s 'func.*Handler' .
EOF
}

_search_escape_regex() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//./\\.}"
  text="${text//\*/\\*}"
  text="${text//+/\\+}"
  text="${text//\?/\\?}"
  text="${text//\(/\\(}"
  text="${text//\)/\\)}"
  text="${text//\[/\\[}"
  text="${text//\]/\\]}"
  text="${text//\{/\\{}"
  text="${text//\}/\\}"
  text="${text//\|/\\|}"
  text="${text//\^/\\^}"
  text="${text//\$/\\$}"
  printf '%s' "$text"
}

_search_pattern() {
  local pattern="$1"
  local starts_with_star=0 ends_with_star=0 core="$pattern"
  local escaped=""

  if [[ -z "$pattern" ]]; then
    echo "s: pattern is required" >&2
    return 1
  fi

  if [[ "$pattern" == '*' ]]; then
    echo "s: pattern cannot be just '*'" >&2
    return 1
  fi

  if [[ "$pattern[1]" == '*' ]]; then
    starts_with_star=1
    core="${pattern#\*}"
  fi

  if [[ -n "$core" && "$core[-1]" == '*' ]]; then
    ends_with_star=1
    core="${core%\*}"
  fi

  if [[ -z "$core" ]]; then
    echo "s: empty search term" >&2
    return 1
  fi

  if (( starts_with_star || ends_with_star )); then
    if (( starts_with_star && ends_with_star )); then
      _SEARCH_FIXED=1
      _SEARCH_REGEX="$core"
      return 0
    fi

    escaped="$(_search_escape_regex "$core")"
    _SEARCH_FIXED=0
    if (( starts_with_star )); then
      _SEARCH_REGEX="${escaped}\$"
    else
      _SEARCH_REGEX="^${escaped}"
    fi
    return 0
  fi

  _SEARCH_FIXED=0
  _SEARCH_REGEX="$pattern"
}

_search_run_rg() {
  local target="$1"
  shift

  export RIPGREP_CONFIG_PATH="${RIPGREP_CONFIG_PATH:-${XDG_CONFIG_HOME:-$HOME/.config}/ripgrep/ripgreprc}"

  if (( _SEARCH_FIXED )); then
    command rg --fixed-strings -e "$_SEARCH_REGEX" "$@" "$target"
  else
    command rg -e "$_SEARCH_REGEX" "$@" "$target"
  fi
}

s() {
  local pattern="${1:-}" target="${2:-.}"

  if [[ -z "$pattern" ]]; then
    _search_usage
    return 1
  fi

  if [[ ! -e "$target" ]]; then
    echo "s: path not found: $target" >&2
    return 1
  fi

  _search_pattern "$pattern" || return $?
  _search_run_rg "$target"
}

_searche_usage() {
  cat >&2 <<'EOF'
usage: se [editor] <pattern> [path]

Pick a ripgrep match with fzf and open it in an editor (at the matched line).

Editors (optional, default: nvim):
  vi, vim, nvim, cursor, code

Wildcards match s (*text, text*, *text*).

Examples:
  se timeout
  se (vi, nvim<default>, cursor, code) timeout ./src
  se cursor '*Error'
EOF
}

_searche_resolve_editor() {
  case "$1" in
    vi|vim|nvim) printf '%s' nvim ;;
    cursor) printf '%s' cursor ;;
    code) printf '%s' code ;;
    *)
      echo "se: unknown editor: $1 (try vi, nvim, cursor, or code)" >&2
      return 1
      ;;
  esac
}

_searche_open() {
  local editor="$1" entry="$2" file="" line="" rest=""

  file="${entry%%:*}"
  rest="${entry#*:}"
  line="${rest%%:*}"
  [[ "$line" =~ '^[0-9]+$' ]] || line=1

  case "$editor" in
    cursor)
      if command -v cursor >/dev/null 2>&1; then
        cursor -g "$file:$line" 2>/dev/null || cursor "$file:$line"
      else
        echo "se: cursor not found" >&2
        return 1
      fi
      ;;
    code)
      if command -v code >/dev/null 2>&1; then
        code -g "$file:$line"
      else
        echo "se: code not found (install VS Code shell command)" >&2
        return 1
      fi
      ;;
    nvim)
      command nvim "+$line" "$file"
      ;;
    *)
      command "$editor" "+$line" "$file"
      ;;
  esac
}

se() {
  local editor="nvim" pattern="" target="."
  local -a known_editors=(vi vim nvim cursor code)
  local selected=""

  if [[ $# -eq 0 ]]; then
    _searche_usage
    return 1
  fi

  if [[ " ${known_editors[*]} " == *" $1 "* ]]; then
    editor="$(_searche_resolve_editor "$1")" || return 1
    shift
  fi

  if [[ $# -eq 0 ]]; then
    _searche_usage
    return 1
  fi

  pattern="${1:-}"
  if [[ -z "$pattern" ]]; then
    _searche_usage
    return 1
  fi
  shift

  target="${1:-.}"

  if [[ ! -e "$target" ]]; then
    echo "se: path not found: $target" >&2
    return 1
  fi

  _search_pattern "$pattern" || return $?

  local target_abs="${target:A}"
  target_abs="${target_abs%/}"
  local preview_cmd="bat --style=numbers --color=always --highlight-line {2} ${(q)target_abs}/{1}"

  command -v fzf >/dev/null 2>&1 || {
    echo "se: fzf not found" >&2
    return 1
  }

  selected="$(
    _search_run_rg "$target" --line-number --no-heading --color=never 2>/dev/null \
      | fzf --delimiter : --nth 3.. \
          --prompt='Open match> ' \
          --preview "$preview_cmd" \
          --preview-window 'up,60%,border-bottom,+{2}+3/3,~3'
  )"
  [[ -n "$selected" ]] || return 0

  _searche_open "$editor" "$selected"
}

_FZF_RG_LIB="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/rg-fzf-lib.zsh"
[[ -f "$_FZF_RG_LIB" ]] && source "$_FZF_RG_LIB"
unset _FZF_RG_LIB

_fzf_rg_resolve_entry() {
  local target="$1" entry="$2" file=""

  file="${entry%%:*}"
  [[ "$file" == /* ]] && print -r -- "$entry" && return 0
  print -r -- "${target%/}/${entry}"
}

_fzf_rg_zle_restore() {
  emulate -L zsh
  stty sane 2>/dev/null
  zle -I 2>/dev/null
  zle reset-prompt 2>/dev/null
  zle -R 2>/dev/null
}

_fzf_rg_open_match() {
  local target_abs="$1" selected="$2" entry="" file="" line="" rest=""

  entry="$(_fzf_rg_resolve_entry "$target_abs" "$selected")"
  file="${entry%%:*}"
  rest="${entry#*:}"
  line="${rest%%:*}"
  [[ "$line" =~ '^[0-9]+$' ]] || line=1

  {
    command nvim "+$line" "$file" < /dev/tty > /dev/tty 2>&1
  } always {
    stty sane 2>/dev/null
  }
}

# Same fzf UI for Ctrl+F and Ctrl+N (uses fzf.env layout; bat preview scrolls to match line).
_fzf_rg_pick() {
  local prompt="$1" preview_cmd="$2" reload_bind="$3"
  setopt localoptions pipefail no_aliases 2>/dev/null

  local rg_bind="change:reload-sync:${reload_bind}"
  local rg_extra="
    --disabled
    --delimiter :
    --nth 3..
    --prompt=${(q)prompt}
    --preview ${(q)preview_cmd}
    --preview-window right:65%:wrap:border-left,+{2}+3/3,~3
    --bind ${(q)rg_bind}
  "

  local stty_saved=""
  [[ -t 0 ]] && stty_saved="$(stty -g 2>/dev/null)"

  if (( $+functions[__fzf_defaults] && $+functions[__fzfcmd] )); then
    FZF_DEFAULT_COMMAND=:
    FZF_DEFAULT_OPTS="$(
      __fzf_defaults \
        "--height=60% --layout=reverse --border=rounded --prompt='  ' --pointer='  '" \
        "${rg_extra}"
    )"
    FZF_DEFAULT_OPTS_FILE=''
    $(__fzfcmd) < /dev/tty
  else
    FZF_DEFAULT_OPTS_FILE=''
    FZF_DEFAULT_OPTS='--height=60% --layout=reverse --border=rounded --preview-window=right:65%:wrap:border-left'
    command fzf --disabled \
      --delimiter : \
      --nth 3.. \
      --prompt="$prompt" \
      --preview "$preview_cmd" \
      --preview-window 'right:65%:wrap:border-left,+{2}+3/3,~3' \
      --bind "change:reload-sync:${reload_bind}" \
      < /dev/tty
  fi
  local ret=$?
  if [[ -n "$stty_saved" ]]; then
    stty "$stty_saved" 2>/dev/null
  fi
  stty sane 2>/dev/null
  return $ret
}

_fzf_rg_live_widget() {
  emulate -L zsh
  setopt localoptions pipefail no_aliases 2>/dev/null

  local target="$1" prompt="$2"
  local target_abs="${target:A}" reloader="" preview_cmd="" reload_bind="" selected=""

  reloader="${XDG_CONFIG_HOME:-$HOME/.config}/fzf/rg-fzf-reload.zsh"
  if ! command -v fzf >/dev/null 2>&1; then
    zle -M "fzf not found"
    return 1
  fi
  if ! command -v rg >/dev/null 2>&1; then
    zle -M "rg not found"
    return 1
  fi
  if [[ ! -f "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/rg-fzf-lib.zsh" ]]; then
    zle -M "missing rg-fzf-lib.zsh (run dotinstall)"
    return 1
  fi
  if [[ ! -x "$reloader" ]]; then
    zle -M "missing $reloader (run dotinstall)"
    return 1
  fi
  if [[ ! -e "$target" ]]; then
    zle -M "path not found: $target"
    return 1
  fi

  target_abs="${target_abs%/}"
  reload_bind="FZF_RG_TARGET=${(q)target_abs} ${(q)reloader}"
  preview_cmd="bat --style=numbers --color=always --highlight-line {2} ${(q)target_abs}/{1}"

  zle -I
  selected="$(_fzf_rg_pick "$prompt" "$preview_cmd" "$reload_bind")"
  _fzf_rg_zle_restore

  [[ -n "$selected" ]] || return 0
  _fzf_rg_open_match "$target_abs" "$selected"
  _fzf_rg_zle_restore
  return 0
}

_fzf_rg_content_widget() {
  emulate -L zsh
  (( ${+_DOTFILES_FZF_RG_ACTIVE} )) && return 0
  typeset -g _DOTFILES_FZF_RG_ACTIVE=1

  {
    _fzf_rg_live_widget "${PWD:A}" 'Rg> '
  } always {
    unset _DOTFILES_FZF_RG_ACTIVE
    _fzf_rg_zle_restore
  }
}

_fzf_rg_notes_widget() {
  emulate -L zsh
  (( ${+_DOTFILES_FZF_RG_ACTIVE} )) && return 0
  typeset -g _DOTFILES_FZF_RG_ACTIVE=1

  {
    local dir="${NOTES_DIR:-}"

    if [[ -z "$dir" ]]; then
      zle -M "NOTES_DIR not set (run dotinstall after user-config.yml notes.directory)"
      return 1
    fi

    _fzf_rg_live_widget "${dir:A}" 'Notes> '
  } always {
    unset _DOTFILES_FZF_RG_ACTIVE
    _fzf_rg_zle_restore
  }
}

_dotfiles_s_bind_fzf_rg_keymaps() {
  local km
  for km in emacs viins vicmd; do
    bindkey -M "$km" '^F' _fzf_rg_content_widget
    bindkey -M "$km" '^N' _fzf_rg_notes_widget
  done
}

_dotfiles_s_register_fzf_rg_widgets() {
  (( ${+_DOTFILES_S_FZF_ZLE_BOUND} )) && return 0
  [[ -o zle ]] || return 1

  zle -N _fzf_rg_content_widget || return 1
  zle -N _fzf_rg_notes_widget || return 1
  _dotfiles_s_bind_fzf_rg_keymaps
  typeset -g _DOTFILES_S_FZF_ZLE_BOUND=1
}

if [[ -n "$ZSH_VERSION" && -o interactive ]]; then
  if ! _dotfiles_s_register_fzf_rg_widgets; then
    autoload -Uz add-zsh-hook
    _dotfiles_s_precmd_bind_fzf_rg() {
      _dotfiles_s_register_fzf_rg_widgets && add-zsh-hook -d precmd _dotfiles_s_precmd_bind_fzf_rg
    }
    add-zsh-hook precmd _dotfiles_s_precmd_bind_fzf_rg
  fi
fi

# Search text in a directory with ripgrep.
# Quote patterns that start with * so the shell does not expand them.
#
# Usage: s <pattern> [path]
#   s abc         search for abc (ripgrep regex; smart-case from ripgreprc)
#   s '*abc'      lines ending with abc
#   s 'abc*'      lines starting with abc
#   s '*abc*'     lines containing abc (same as abc for plain text)
#   s abc ./src   search under ./src
#
# Ctrl+F / Ctrl+N: type a full ripgrep argument list (e.g. -i -t md TODO), not s wildcards.

_search_usage() {
  cat >&2 <<'EOF'
usage: s <pattern> [path]

Wildcards (quote patterns that contain *):
  abc       ripgrep search for abc
  *abc      lines ending with abc
  abc*      lines starting with abc
  *abc*     lines containing abc

Examples:
  s timeout
  s '*Error' ./src
  s 'func.*Handler' .
EOF
}

_search_escape_regex() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//./\\.}"
  text="${text//\*/\\*}"
  text="${text//+/\\+}"
  text="${text//\?/\\?}"
  text="${text//\(/\\(}"
  text="${text//\)/\\)}"
  text="${text//\[/\\[}"
  text="${text//\]/\\]}"
  text="${text//\{/\\{}"
  text="${text//\}/\\}"
  text="${text//\|/\\|}"
  text="${text//\^/\\^}"
  text="${text//\$/\\$}"
  printf '%s' "$text"
}

_search_pattern() {
  local pattern="$1"
  local starts_with_star=0 ends_with_star=0 core="$pattern"
  local escaped=""

  if [[ -z "$pattern" ]]; then
    echo "s: pattern is required" >&2
    return 1
  fi

  if [[ "$pattern" == '*' ]]; then
    echo "s: pattern cannot be just '*'" >&2
    return 1
  fi

  if [[ "$pattern[1]" == '*' ]]; then
    starts_with_star=1
    core="${pattern#\*}"
  fi

  if [[ -n "$core" && "$core[-1]" == '*' ]]; then
    ends_with_star=1
    core="${core%\*}"
  fi

  if [[ -z "$core" ]]; then
    echo "s: empty search term" >&2
    return 1
  fi

  if (( starts_with_star || ends_with_star )); then
    if (( starts_with_star && ends_with_star )); then
      _SEARCH_FIXED=1
      _SEARCH_REGEX="$core"
      return 0
    fi

    escaped="$(_search_escape_regex "$core")"
    _SEARCH_FIXED=0
    if (( starts_with_star )); then
      _SEARCH_REGEX="${escaped}\$"
    else
      _SEARCH_REGEX="^${escaped}"
    fi
    return 0
  fi

  _SEARCH_FIXED=0
  _SEARCH_REGEX="$pattern"
}

_search_run_rg() {
  local target="$1"
  shift

  export RIPGREP_CONFIG_PATH="${RIPGREP_CONFIG_PATH:-${DOTFILES_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}}/ripgrep/ripgreprc}"

  if (( _SEARCH_FIXED )); then
    command rg --fixed-strings -e "$_SEARCH_REGEX" "$@" "$target"
  else
    command rg -e "$_SEARCH_REGEX" "$@" "$target"
  fi
}

# @help s <pattern> [path] | ripgrep search; *abc = ends with, abc* = starts with
s() {
  local pattern="${1:-}" target="${2:-.}"

  if [[ -z "$pattern" ]]; then
    _search_usage
    return 1
  fi

  if [[ ! -e "$target" ]]; then
    echo "s: path not found: $target" >&2
    return 1
  fi

  _search_pattern "$pattern" || return $?
  _search_run_rg "$target"
}

_searche_usage() {
  cat >&2 <<'EOF'
usage: se [editor] <pattern> [path]

Pick a ripgrep match with fzf and open it in an editor (at the matched line).

Editors (optional, default: nvim):
  vi, vim, nvim, cursor, code

Wildcards match s (*text, text*, *text*).

Examples:
  se timeout
  se (vi, nvim<default>, cursor, code) timeout ./src
  se cursor '*Error'
EOF
}

_searche_resolve_editor() {
  case "$1" in
    vi|vim|nvim) printf '%s' nvim ;;
    cursor) printf '%s' cursor ;;
    code) printf '%s' code ;;
    *)
      echo "se: unknown editor: $1 (try vi, nvim, cursor, or code)" >&2
      return 1
      ;;
  esac
}

# file:line → editor at that line (used by se and the Ctrl+F/Ctrl+N widgets).
_open_at_line() {
  local editor="$1" file="$2" line="$3"
  [[ "$line" =~ '^[0-9]+$' ]] || line=1

  case "$editor" in
    cursor|code)
      if ! command -v "$editor" >/dev/null 2>&1; then
        echo "open: $editor not found" >&2
        return 1
      fi
      command "$editor" -g "$file:$line"
      ;;
    *)
      command "$editor" "+$line" "$file"
      ;;
  esac
}

# @help se [editor] <pattern> [path] | pick a match in fzf, open at the line (nvim/vim/cursor/code)
se() {
  local editor="nvim" pattern="" target="."
  local -a known_editors=(vi vim nvim cursor code)
  local selected=""

  if [[ $# -eq 0 ]]; then
    _searche_usage
    return 1
  fi

  if [[ " ${known_editors[*]} " == *" $1 "* ]]; then
    editor="$(_searche_resolve_editor "$1")" || return 1
    shift
  fi

  if [[ $# -eq 0 ]]; then
    _searche_usage
    return 1
  fi

  pattern="${1:-}"
  if [[ -z "$pattern" ]]; then
    _searche_usage
    return 1
  fi
  shift

  target="${1:-.}"

  if [[ ! -e "$target" ]]; then
    echo "se: path not found: $target" >&2
    return 1
  fi

  _search_pattern "$pattern" || return $?

  local target_abs="${target:A}"
  target_abs="${target_abs%/}"
  local preview_cmd="bat --style=numbers --color=always --highlight-line {2} ${(q)target_abs}/{1}"

  command -v fzf >/dev/null 2>&1 || {
    echo "se: fzf not found" >&2
    return 1
  }

  selected="$(
    _search_run_rg "$target" --line-number --no-heading --color=never 2>/dev/null \
      | fzf --delimiter : --nth 3.. \
          --prompt='Open match> ' \
          --preview "$preview_cmd" \
          --preview-window 'up,60%,border-bottom,+{2}+3/3,~3'
  )"
  [[ -n "$selected" ]] || return 0

  local rest="${selected#*:}"
  _open_at_line "$editor" "${selected%%:*}" "${rest%%:*}"
}

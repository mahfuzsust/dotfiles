# Git aliases and helpers

_git_push_after_rebase() {
  local branch="$1"
  local upstream="" remote_ref="origin/$branch"
  local ahead=0 behind=0

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    upstream='@{u}'
  elif git show-ref --verify --quiet "refs/remotes/$remote_ref"; then
    upstream="$remote_ref"
  else
    git push -u origin "$branch" "${@:2}"
    return $?
  fi

  ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
  behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
  if (( ahead == 0 && behind == 0 )); then
    echo "gppr: already up to date with $upstream"
    return 0
  fi

  if (( behind > 0 )); then
    if [[ "$upstream" == "$remote_ref" ]]; then
      git push --force-with-lease origin "$branch" "${@:2}"
    else
      git push --force-with-lease "${@:2}"
    fi
  elif [[ "$upstream" == "$remote_ref" ]]; then
    git push origin "$branch" "${@:2}"
  else
    git push "${@:2}"
  fi
}

gpp() {
  git push "$@"
}

# Rebase onto origin/main (or master), then push (new branch: -u origin; on origin: push / --force-with-lease)
gppr() {
  local branch="" base=""

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "gppr: not a git repository" >&2
    return 1
  }

  branch="$(git branch --show-current)"
  if [[ -z "$branch" ]]; then
    echo "gppr: unable to determine current branch" >&2
    return 1
  fi

  base="$(_git_base_branch)" || return 1
  git fetch origin "$branch" "$base" 2>/dev/null || git fetch origin "$base" 2>/dev/null || true

  git rebase "origin/$base" --autostash "$@" || return $?

  _git_push_after_rebase "$branch" "$@"
}


grr() {
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "grr: not a git repository" >&2
    return 1
  }

  git reset --hard HEAD
  git clean -fd
}

_grb_fork_point() {
  local branch="$1"
  local fp="" line="" base=""

  # Oldest reflog entry: commit HEAD pointed to when this branch was created.
  line="$(git reflog show "$branch" --format='%H %gs' 2>/dev/null | tail -1)" || true
  if [[ -n "$line" ]]; then
    fp="${line%% *}"
    if git cat-file -e "$fp^{commit}" 2>/dev/null; then
      printf '%s' "$fp"
      return 0
    fi
    fp=""
  fi

  if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
    fp="$(git merge-base --fork-point '@{u}' HEAD 2>/dev/null || true)"
    if [[ -n "$fp" ]] && git cat-file -e "$fp^{commit}" 2>/dev/null; then
      printf '%s' "$fp"
      return 0
    fi
  fi

  base="$(_git_base_branch 2>/dev/null)" || return 1
  if git show-ref --verify --quiet "refs/remotes/origin/$base" 2>/dev/null; then
    fp="$(git merge-base "origin/$base" HEAD 2>/dev/null || true)"
  fi
  if [[ -z "$fp" ]] && git show-ref --verify --quiet "refs/heads/$base" 2>/dev/null; then
    fp="$(git merge-base "$base" HEAD 2>/dev/null || true)"
  fi

  [[ -n "$fp" ]] || return 1
  printf '%s' "$fp"
}

_git_base_branch() {
  local branch=""

  if git show-ref --verify --quiet refs/heads/main; then
    branch=main
  elif git show-ref --verify --quiet refs/heads/master; then
    branch=master
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    branch=main
  elif git show-ref --verify --quiet refs/remotes/origin/master; then
    branch=master
  else
    echo "gn: unable to find main or master branch" >&2
    return 1
  fi

  printf '%s' "$branch"
}

gn() {
  local branch="$1" base="" stashed=0

  if [[ -z "$branch" ]]; then
    echo "usage: gn <branch-name>" >&2
    return 1
  fi

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "gn: not a git repository" >&2
    return 1
  }

  if [[ -n "$(git status --porcelain)" ]]; then
    git stash push -u -m "gn: auto-stash for $branch" || return 1
    stashed=1
  fi

  base="$(_git_base_branch)" || {
    (( stashed )) && git stash pop
    return 1
  }

  if git show-ref --verify --quiet "refs/heads/$base"; then
    git checkout "$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  elif git show-ref --verify --quiet "refs/remotes/origin/$base"; then
    git fetch origin "$base" 2>/dev/null || true
    git checkout -b "$base" "origin/$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  else
    echo "gn: base branch $base not found locally or on origin" >&2
    (( stashed )) && git stash pop
    return 1
  fi

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git pull --ff-only || {
      (( stashed )) && git stash pop
      return 1
    }
  elif git remote get-url origin >/dev/null 2>&1 \
    && git rev-parse --verify "origin/$base" >/dev/null 2>&1; then
    git pull --ff-only origin "$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  fi

  git checkout -b "$branch" || {
    (( stashed )) && git stash pop
    return 1
  }

  if (( stashed )); then
    git stash pop || {
      echo "gn: branch created; resolve stash conflicts manually" >&2
      return 1
    }
  fi
}

# Zsh: drop a pre-existing `grb` alias (old dotfiles or git plugins) before defining the function.
unalias grb 2>/dev/null || true

grb() {
  local branch="" base="" onto="" count=0

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "grb: not a git repository" >&2
    return 1
  }

  branch="$(git branch --show-current)"
  if [[ -z "$branch" ]]; then
    echo "grb: detached HEAD" >&2
    return 1
  fi

  base="$(_git_base_branch)" || return 1
  if [[ "$branch" == "$base" ]]; then
    echo "grb: checkout a feature branch first (currently on $base)" >&2
    return 1
  fi

  onto="$(_grb_fork_point "$branch")" || {
    echo "grb: could not find where this branch was created (reflog expired?)" >&2
    return 1
  }

  count="$(git rev-list --count "$onto"..HEAD 2>/dev/null || echo 0)"
  if [[ "$count" -eq 0 ]]; then
    echo "grb: no commits to rebase on this branch" >&2
    return 1
  fi

  if [[ ! -e /dev/tty ]]; then
    echo "grb: no TTY for interactive rebase (git rebase -i)" >&2
    return 1
  fi

  git rebase -i --autostash "$onto" "$@" </dev/tty >/dev/tty
}


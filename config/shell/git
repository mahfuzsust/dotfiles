# Git aliases and helpers

_git_push_after_rebase() {
  local branch="$1"
  local upstream="" remote_ref="origin/$branch"
  local ahead=0 behind=0

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    upstream='@{u}'
  elif git show-ref --verify --quiet "refs/remotes/$remote_ref"; then
    upstream="$remote_ref"
  else
    git push -u origin "$branch" "${@:2}"
    return $?
  fi

  ahead="$(git rev-list --count "$upstream..HEAD" 2>/dev/null || echo 0)"
  behind="$(git rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)"
  if (( ahead == 0 && behind == 0 )); then
    echo "gppr: already up to date with $upstream"
    return 0
  fi

  if (( behind > 0 )); then
    if [[ "$upstream" == "$remote_ref" ]]; then
      git push --force-with-lease origin "$branch" "${@:2}"
    else
      git push --force-with-lease "${@:2}"
    fi
  elif [[ "$upstream" == "$remote_ref" ]]; then
    git push origin "$branch" "${@:2}"
  else
    git push "${@:2}"
  fi
}

gpp() {
  git push "$@"
}

# Rebase onto origin/main (or master), then push (new branch: -u origin; on origin: push / --force-with-lease)
gppr() {
  local branch="" base=""

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "gppr: not a git repository" >&2
    return 1
  }

  branch="$(git branch --show-current)"
  if [[ -z "$branch" ]]; then
    echo "gppr: unable to determine current branch" >&2
    return 1
  fi

  base="$(_git_base_branch)" || return 1
  git fetch origin "$branch" "$base" 2>/dev/null || git fetch origin "$base" 2>/dev/null || true

  git rebase "origin/$base" --autostash "$@" || return $?

  _git_push_after_rebase "$branch" "$@"
}


grr() {
  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "grr: not a git repository" >&2
    return 1
  }

  git reset --hard HEAD
  git clean -fd
}

_git_base_branch() {
  local branch=""

  if git show-ref --verify --quiet refs/heads/main; then
    branch=main
  elif git show-ref --verify --quiet refs/heads/master; then
    branch=master
  elif git show-ref --verify --quiet refs/remotes/origin/main; then
    branch=main
  elif git show-ref --verify --quiet refs/remotes/origin/master; then
    branch=master
  else
    echo "gn: unable to find main or master branch" >&2
    return 1
  fi

  printf '%s' "$branch"
}

gn() {
  local branch="$1" base="" stashed=0

  if [[ -z "$branch" ]]; then
    echo "usage: gn <branch-name>" >&2
    return 1
  fi

  git rev-parse --git-dir >/dev/null 2>&1 || {
    echo "gn: not a git repository" >&2
    return 1
  }

  if [[ -n "$(git status --porcelain)" ]]; then
    git stash push -u -m "gn: auto-stash for $branch" || return 1
    stashed=1
  fi

  base="$(_git_base_branch)" || {
    (( stashed )) && git stash pop
    return 1
  }

  if git show-ref --verify --quiet "refs/heads/$base"; then
    git checkout "$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  elif git show-ref --verify --quiet "refs/remotes/origin/$base"; then
    git fetch origin "$base" 2>/dev/null || true
    git checkout -b "$base" "origin/$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  else
    echo "gn: base branch $base not found locally or on origin" >&2
    (( stashed )) && git stash pop
    return 1
  fi

  if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git pull --ff-only || {
      (( stashed )) && git stash pop
      return 1
    }
  elif git remote get-url origin >/dev/null 2>&1 \
    && git rev-parse --verify "origin/$base" >/dev/null 2>&1; then
    git pull --ff-only origin "$base" || {
      (( stashed )) && git stash pop
      return 1
    }
  fi

  git checkout -b "$branch" || {
    (( stashed )) && git stash pop
    return 1
  }

  if (( stashed )); then
    git stash pop || {
      echo "gn: branch created; resolve stash conflicts manually" >&2
      return 1
    }
  fi
}


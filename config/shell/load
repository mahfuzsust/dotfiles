# Load dotfiles shell modules (add new files alongside this one; they are sourced automatically).
DOTFILES_SHELL="${DOTFILES_SHELL:-$HOME/.config/shell}"

if [[ -f "$DOTFILES_SHELL/taskwarrior" ]]; then
  source "$DOTFILES_SHELL/taskwarrior"
elif [[ -f "${DOTFILES_DIR:-$HOME/dotfiles}/config/shell/taskwarrior" ]]; then
  source "${DOTFILES_DIR:-$HOME/dotfiles}/config/shell/taskwarrior"
fi

for module in "$DOTFILES_SHELL"/*(N); do
  [[ -f "$module" ]] || continue
  case "${module:t}" in
    aliases|load|taskwarrior) continue ;;
  esac
  source "$module"
done

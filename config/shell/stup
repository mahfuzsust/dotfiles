# work standup: yesterday/today tasks (+ Fri–Mon when run on Monday).

_stup_prev_day() {
  date -j -v-1d -f "%Y-%m-%d" "$1" "+%Y-%m-%d"
}

_stup_next_day() {
  date -j -v+1d -f "%Y-%m-%d" "$1" "+%Y-%m-%d"
}

_stup_filter() {
  local date_filter="" today="" last_friday="" end_after="" end_before=""

  if [[ "$(date +%u)" == "1" ]]; then
    # Taskwarrior `friday` is the *upcoming* Friday, not last week's — use calendar bounds.
    today="$(date +%Y-%m-%d)"
    last_friday="$(date -v-3d +%Y-%m-%d)"
    end_after="$(_stup_prev_day "$last_friday")"
    end_before="$(_stup_next_day "$today")"
    date_filter="(end.after:${end_after} and end.before:${end_before}) and +work"
  else
    date_filter="(start:yesterday or end:yesterday or end:today) and +work"
  fi

  print -r -- "$date_filter"
}

_stup_section() {
  local title=$1
  shift
  local output="" err="" rc=0

  err="$(mktemp)"
  output="$(_tw_report "$@" 2>"$err")"
  rc=$?
  output="${output//$'No matches.'/}"
  output="${output#"${output%%[![:space:]]*}"}"
  output="${output%"${output##*[![:space:]]}"}"

  if [[ -s "$err" ]]; then
    local errtext="$(<"$err")"
    errtext="${errtext#"${errtext%%[![:space:]]*}"}"
    errtext="${errtext%"${errtext##*[![:space:]]}"}"
    if [[ -n "$errtext" && "$errtext" != "No matches." ]]; then
      print -u2 "stup: $title: $errtext"
      rm -f "$err"
      return 1
    fi
  fi
  rm -f "$err"

  [[ -n "${output//[$' \t']/}" ]] || return 1

  if (( _stup_sections_printed )); then
    print -r -- ""
  fi

  print -r -- "====== <$title> ======"
  print -r -- "$output"
  _stup_sections_printed=1
}

# @help stup | task standup helper
stup() {
  typeset -i _stup_sections_printed=0
  local filter=""

  if ! command -v tk >/dev/null 2>&1 \
      && [[ ! -x "${HOMEBREW_PREFIX:-/opt/homebrew}/opt/task/bin/task" ]]; then
    print -u2 "stup: taskwarrior not found (tk)"
    return 1
  fi

  filter="$(_stup_filter)"

  _stup_section "Completed" "$filter" status:completed all || true
  _stup_section "In Progress" +work '(status:active or start:today)' status.not:completed all || true
  _stup_section "Pending" +work status:pending -ACTIVE all || true

  if (( ! _stup_sections_printed )); then
    if [[ "$(date +%u)" == "1" ]]; then
      print -r -- "No tasks matched standup filters (+work, completed since last Friday)."
    else
      print -r -- "No tasks matched standup filters (+work, today/yesterday)."
    fi
  fi
}

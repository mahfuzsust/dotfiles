# config/fzf/fzf.env (interactive; ripgrep env lives in ~/.config/zsh/zenv)
# fzf UI/preview inspired by https://github.com/radleylewis/zsh/blob/main/fzf.zsh

export FZF_DEFAULT_COMMAND='fd --type f --hidden --strip-cwd-prefix'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND='fd --type d --hidden --strip-cwd-prefix'

export FZF_DEFAULT_OPTS='
  --height=60%
  --layout=reverse
  --border=rounded
  --prompt="  "
  --pointer="  "
  --preview-window=right:65%:wrap:border-left
'

export _FZF_PREVIEW_CMD='bat --color=always --style=plain,numbers --line-range=:500 {}'
export FZF_CTRL_T_OPTS="--preview '$_FZF_PREVIEW_CMD'"

_fzf_source_shell_integration() {
  local shell_name="$1"
  command -v fzf >/dev/null 2>&1 || return 1

  # mise/aqua installs ship the binary only; fzf --zsh|--bash embeds key bindings.
  if fzf "--${shell_name}" >/dev/null 2>&1; then
    # shellcheck disable=SC1090
    source <(fzf "--${shell_name}")
    return 0
  fi

  if command -v brew >/dev/null 2>&1; then
    local prefix="${HOMEBREW_PREFIX:-$(brew --prefix 2>/dev/null)}"
    [[ -f "${prefix}/opt/fzf/shell/completion.${shell_name}" ]] \
      && source "${prefix}/opt/fzf/shell/completion.${shell_name}"
    [[ -f "${prefix}/opt/fzf/shell/key-bindings.${shell_name}" ]] \
      && source "${prefix}/opt/fzf/shell/key-bindings.${shell_name}"
    return 0
  fi
  return 1
}

if [ -n "$BASH_VERSION" ]; then
  _fzf_source_shell_integration bash
elif [ -n "$ZSH_VERSION" ]; then
  _fzf_source_shell_integration zsh

  # Custom bindkeys (Option+c / Option+d on US Mac keyboards)
  if (( ${+widgets[fzf-cd-widget]} )); then
    bindkey "ç" fzf-cd-widget
  fi
fi

unset -f _fzf_source_shell_integration 2>/dev/null || true

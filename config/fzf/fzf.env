# config/fzf/fzf.env

export RIPGREP_CONFIG_PATH="$HOME/.config/ripgrep/ripgreprc"

# fd will automatically read ~/.config/fd/ignore now
export FZF_DEFAULT_COMMAND="fd --type f --hidden"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type d --hidden"
export FZF_DEFAULT_OPTS="--layout=reverse --border --inline-info"

if [ -n "$BASH_VERSION" ]; then
    _fzf_shell="bash"
elif [ -n "$ZSH_VERSION" ]; then
    _fzf_shell="zsh"
fi

if [ -n "$_fzf_shell" ] && command -v brew &> /dev/null; then
    _brew_prefix=$(brew --prefix)

    # Source Auto-completion
    if [[ -f "${_brew_prefix}/opt/fzf/shell/completion.${_fzf_shell}" ]]; then
        source "${_brew_prefix}/opt/fzf/shell/completion.${_fzf_shell}"
    fi

    # Source Key bindings
    if [[ -f "${_brew_prefix}/opt/fzf/shell/key-bindings.${_fzf_shell}" ]]; then
        source "${_brew_prefix}/opt/fzf/shell/key-bindings.${_fzf_shell}"

        # NEW: Custom bindkey for zsh
        if [ "$_fzf_shell" = "zsh" ]; then
            bindkey "ç" fzf-cd-widget
        fi
    fi

    unset _brew_prefix
fi

unset _fzf_shell

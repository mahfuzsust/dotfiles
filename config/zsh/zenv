# Universal zsh environment (sourced from ~/.zshenv for all zsh invocations).
# Keep this file minimal — no slow init, no interactive-only bindings.

# Non-login shells (fzf rg reload, scripts) skip ~/.zprofile; still need Homebrew tools.
for _brew_bin in /opt/homebrew/bin /usr/local/bin; do
  [[ -d "$_brew_bin" ]] || continue
  case ":${PATH}:" in
    *":${_brew_bin}:"*) ;;
    *) PATH="${_brew_bin}:${PATH}" ;;
  esac
done
unset _brew_bin

# Single source of truth for where dotfiles are linked (XDG-aware).
export DOTFILES_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}"
export RIPGREP_CONFIG_PATH="$DOTFILES_CONFIG/ripgrep/ripgreprc"

# delta uses less internally; -R keeps colors, -F quit if one screen
if [[ -z "${DELTA_PAGER:-}" ]] && command -v less >/dev/null 2>&1; then
  export DELTA_PAGER="less -RFX"
fi

# Managed interactive-shell setup — the ONE line in ~/.zshrc is `source ~/.config/zsh/zshrc`.
# Edit this file (tracked in the repo); `dotinstall` only links it. Order matters: top to bottom.
#
# Hooks (optional, not tracked):
#   ~/.config/zsh/pre-omz.zsh   runs before Oh My Zsh (override ZSH_THEME, plugins=(...))
#   ~/.config/zsh/local.zsh     runs last (machine-specific aliases, PATH, secrets)
# Profile startup time with: dotprof

[[ -n "${DOTFILES_ZPROF:-}" ]] && zmodload zsh/zprof
# @help dotprof | zsh startup profile (zprof)
dotprof() { DOTFILES_ZPROF=1 zsh -i -c zprof; }

_dotfiles_cfg="${DOTFILES_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}}"

# --- completions (must be before Oh My Zsh runs compinit) ---
export ZSH_DISABLE_COMPFIX=true
[[ -d "${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-completions" ]] \
  && FPATH="${HOMEBREW_PREFIX:-/opt/homebrew}/share/zsh-completions:$FPATH"

# --- Oh My Zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions fast-syntax-highlighting)
[[ -f "$_dotfiles_cfg/zsh/pre-omz.zsh" ]] && source "$_dotfiles_cfg/zsh/pre-omz.zsh"
[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

# --- tools ---
typeset -U path  # no duplicate PATH entries
# Go binaries (no `go env` fork; GOPATH defaults to ~/go)
[[ -d "${GOPATH:-$HOME/go}/bin" ]] && path+=("${GOPATH:-$HOME/go}/bin")
export GPG_TTY=$(tty)
source "$_dotfiles_cfg/fzf/fzf.env"
source "$_dotfiles_cfg/zsh/zoxide.env"
source "$_dotfiles_cfg/zsh/lazy-nvm.zsh"
source "$_dotfiles_cfg/zsh/kubectl-completion.zsh"

# --- aliases: after Oh My Zsh (its git plugin defines gpr = pull --rebase) ---
unalias gpr gprm kubectl 2>/dev/null
source "$_dotfiles_cfg/shell/aliases"

[[ -f "$_dotfiles_cfg/zsh/local.zsh" ]] && source "$_dotfiles_cfg/zsh/local.zsh"
unset _dotfiles_cfg
